    },
    {
      "parameters": {
        "jsCode": "// =====================================================\n// SIMPLE DEDUP - Sadece WhatsApp duplicate webhook'larını filtrele\n// Coalescing YOK - Backend hallediyor\n// =====================================================\n\nconst items = $input.all();\nconst results = [];\n\nconst data = $getWorkflowStaticData('global');\ndata.seenMessageIds = data.seenMessageIds || {};\n\nconst now = Date.now();\nconst DEDUP_WINDOW_MS = 60 * 1000; // 1 dakika\n\n// Eski kayıtları temizle\nfor (const id in data.seenMessageIds) {\n  if (data.seenMessageIds[id] < now - DEDUP_WINDOW_MS) {\n    delete data.seenMessageIds[id];\n  }\n}\n\nfor (const item of items) {\n  const phone = String(item.json.phone || '').replace(/[^0-9]/g, '');\n  const message = String(item.json.message || '').trim();\n  const messageId = item.json.messageId || '';\n\n  if (!phone || !message) continue;\n\n  // Sadece messageId bazlı dedup (WhatsApp bazen aynı webhook'u 2 kez gönderir)\n  if (messageId && data.seenMessageIds[messageId]) {\n    console.log('DEDUP: Skipping duplicate messageId:', messageId);\n    continue;\n  }\n\n  if (messageId) {\n    data.seenMessageIds[messageId] = now;\n  }\n\n  results.push({\n    json: {\n      phone: phone,\n      message: message,\n      messageId: messageId,\n      timestamp: now\n    }\n  });\n}\n\nreturn results;"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        480,
        176
      ],
      "id": "b21a01fc-a262-4c11-9aee-3d1907b13502",
      "name": "Simple Dedup",
      "alwaysOutputData": false
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://127.0.0.1:8000/chat",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"phone\": \"{{ $json.phone }}\",\n  \"message\": \"{{ ($json.message || '').replace(/\\\\/g, '\\\\\\\\').replace(/\"/g, '\\\\\"').replace(/\\n/g, '\\\\n').replace(/\\r/g, '') }}\",\n  \"message_id\": \"{{ $json.messageId || '' }}\"\n}",
        "options": {
          "timeout": 60000
        }
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        752,
        176
      ],
      "id": "9de60b15-6a14-4774-bac8-1b837fe36c76",
      "name": "Bot API",
      "alwaysOutputData": false
    },
    {
      "parameters": {
        "jsCode": "// =====================================================\n// RESPONSE CHECK - Boş response filtrele\n// =====================================================\n\nconst items = $input.all();\nconst results = [];\n\nfor (const item of items) {\n  const reply = item.json.reply || item.json.response || '';\n  const status = item.json.status || '';\n  const phone = item.json.phone || '';\n\n  // Boş veya 'empty' status varsa WhatsApp'a gönderme\n  if (!reply || reply.trim() === '' || status === 'empty' || status === 'duplicate') {\n    console.log('SKIP: Empty or duplicate response for', phone);\n    continue;\n  }\n\n  // Phone bilgisi yoksa önceki node'dan al\n  let finalPhone = phone;\n  if (!finalPhone) {\n    try {\n      const dedupData = $('Simple Dedup').first();\n      finalPhone = dedupData?.json?.phone || '';\n    } catch(e) {}\n  }\n\n  if (!finalPhone) {\n    console.log('SKIP: No phone number');\n    continue;\n  }\n\n  results.push({\n    json: {\n      phone: finalPhone,\n      reply: reply,\n      status: status\n    }\n  });\n}\n\nreturn results;"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
